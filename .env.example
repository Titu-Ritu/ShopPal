# ── ShopPal configuration ─────────────────────────────────────────────
# Any key left blank switches that service to realistic mock data, so the
# demo never breaks. Set MOCK_MODE=true to force everything into mock mode.
MOCK_MODE=false
PORT=3000

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Effort for Claude 4.6+ models (low | medium | high). Leave blank for claude-sonnet-4-5.
ANTHROPIC_EFFORT=low

# Channel3 product search (https://trychannel3.com)
CHANNEL3_API_KEY=

# PayPal REST app, SANDBOX credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
